<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Mdex.Mcp.Tools\Mdex.Mcp.Tools.csproj" />
    <ProjectReference Include="..\Mdex.Tokens\Mdex.Tokens.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="5.4.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="5.4.0" />
    <!-- EF Core pinned to 8.x to match OpenIddict 5.4.0 (its highest target is net8.0/EF 8). EF 9
         moved ExecuteDeleteAsync out of RelationalQueryableExtensions, which breaks OpenIddict's
         client DeleteAsync path (used when removing clients dropped from the config). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mdex.Gateway</RootNamespace>
    <AssemblyName>mdex-gateway</AssemblyName>
  </PropertyGroup>

</Project>
